{
	"name": "vixely",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/theme-bootstrap.ts && vite build && bun scripts/csp.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --max-warnings=0",
		"format": "oxfmt --check .",
		"format:write": "oxfmt .",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test": "vitest run --project unit",
		"checks": "bun run --parallel typecheck lint format test:unit",
		"ci": "bun run checks && bun run build && bun run bundle-budget",
		"bundle-budget": "bun scripts/bundle-budget.ts",
		"fixtures": "bun scripts/make-fixtures.ts",
		"test:e2e": "playwright test",
		"serve": "bun scripts/serve-static.ts"
	},
	"dependencies": {
		"@mediabunny/aac-encoder": "1.55.1",
		"@mediabunny/ac3": "1.55.1",
		"@mediabunny/dts": "1.55.1",
		"@mediabunny/flac-encoder": "1.55.1",
		"@mediabunny/mp3-encoder": "1.55.1",
		"@mediabunny/prores": "1.55.1",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-start": "1.168.48",
		"@tanstack/react-virtual": "3.14.10",
		"comlink": "4.4.2",
		"mediabunny": "1.55.1",
		"react": "19.2.8",
		"react-aria-components": "1.20.0",
		"react-dom": "19.2.8",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.34",
		"@types/bun": "^1.3.14",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"playwright": "1.62.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"vitest-browser-react": "^2.2.0"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
