{
	"name": "vixely",
	"version": "1.0.0-alpha.0",
	"private": true,
	"description": "Edit video, images, GIFs, audio and subtitles in your browser. Nothing is uploaded.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "bun run build:wasm && vite",
		"build": "bun run build:wasm && bun run build:site",
		"build:wasm": "bun scripts/build-wasm.ts",
		"build:site": "vite build && bun scripts/prerender.ts && bun scripts/service-worker.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src --type-aware --type-check",
		"lint:fix": "oxlint src --type-aware --type-check --fix",
		"fmt": "oxfmt src --write",
		"fmt:check": "oxfmt src --check",
		"test": "vitest run",
		"test:rust": "cargo test --workspace --release"
	},
	"dependencies": {
		"@fontsource-variable/caveat": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/oswald": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/anton": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
		"@fontsource/pacifico": "^5.3.0",
		"@fontsource/permanent-marker": "^5.3.0",
		"@mediabunny/aac-encoder": "1.61.3",
		"@mediabunny/ac3": "1.61.3",
		"@mediabunny/dts": "1.61.3",
		"@mediabunny/flac-encoder": "1.61.3",
		"@mediabunny/mp3-encoder": "1.61.3",
		"@tanstack/react-router": "^1.170.42",
		"fflate": "^0.8.3",
		"jassub": "2.5.20",
		"libheif-js": "^1.23.5",
		"lucide-react": "^1.55.0",
		"mediabunny": "1.61.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tesseract.js-core": "^7.0.0",
		"wasm-feature-detect": "^1.9.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.27.0",
		"@shadcn/lint": "^0.2.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.43",
		"@twemoji/svg": "^15.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"patchedDependencies": {
		"jassub@2.5.20": "patches/jassub@2.5.20.patch",
		"mediabunny@1.61.3": "patches/mediabunny@1.61.3.patch",
		"@mediabunny/aac-encoder@1.61.3": "patches/@mediabunny%2Faac-encoder@1.61.3.patch"
	}
}
