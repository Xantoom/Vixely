{
	"name": "vixely",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "./scripts/copy-jassub.sh",
		"dev": "vite",
		"build:wasm": "./scripts/build-wasm.sh",
		"build:routes": "node ./scripts/generate-route-tree.mjs",
		"build:brand": "bun ./scripts/render-brand.ts",
		"generate:routes": "bun run build:routes",
		"build:prep": "bun run build:wasm && bun run build:routes",
		"build:web": "vite build",
		"build:sitemap": "node ./scripts/generate-sitemap.mjs",
		"build:prerender": "node ./scripts/prerender-routes.mjs",
		"build": "bun run build:prep && bun run build:web && bun run build:sitemap && bun run build:prerender",
		"lint": "oxlint src --type-aware --type-check",
		"lint:fix": "oxlint src --type-aware --type-check --fix",
		"fmt": "oxfmt src '!src/routeTree.gen.ts' --write",
		"fmt:check": "oxfmt src '!src/routeTree.gen.ts' --check"
	},
	"dependencies": {
		"@fontsource/dm-sans": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@mediabunny/ac3": "^1.41.0",
		"@tanstack/react-query": "^5.100.5",
		"@tanstack/react-router": "^1.168.25",
		"fflate": "^0.8.2",
		"jassub": "^2.5.1",
		"lucide-react": "^1.11.0",
		"mediabunny": "^1.41.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-helmet-async": "^3.0.0",
		"sonner": "^2.0.7",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-router-devtools": "^1.166.13",
		"@tanstack/router-plugin": "^1.167.28",
		"@types/bun": "^1.3.13",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"oxlint-tsgolint": "^0.22.1",
		"tailwindcss": "^4.2.4",
		"vite": "^8.0.10",
		"vite-plugin-wasm": "^3.6.0"
	},
	"peerDependencies": {
		"typescript": "6.0.3"
	}
}
