		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/anton": "^5.3.0",
		"@fontsource/arimo": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
		"@fontsource/carlito": "^5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/comic-neue": "^5.3.0",
		"@fontsource/cousine": "^5.3.0",
		"@fontsource/geist": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/gelasio": "^5.3.0",
		"@fontsource/oswald": "^5.3.0",
		"@fontsource/pacifico": "^5.3.0",
		"@fontsource/permanent-marker": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@fontsource/tinos": "^5.3.0",
		"@mediabunny/aac-encoder": "1.65.1",
		"@mediabunny/ac3": "1.65.1",
		"@mediabunny/dts": "1.65.1",
