+                u32OrU64(startOffset), // Segment duration
+                i32OrI64(-1), // Media time
+                fixed_16_16(1), // Media rate
+                // #2
+                u32OrU64(mediaDuration), // Segment duration
+                i32OrI64(0), // Media time
+                fixed_16_16(1), // Media rate
