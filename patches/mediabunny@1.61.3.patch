+    const nextTrackId = Math.max(0, ...trackDatas.map(x => x.track.id)) + 1;
+    // Conditionally use u64 if u32 isn't enough
+    const needsU64 = !isU32(creationTime) || !isU32(duration);
+    const u32OrU64 = needsU64 ? u64 : u32;
