+                ascii('iso5'),
+                ascii('iso6'),
+                ascii('mp41'),
+                ascii('cmfc'),
+                ascii('dash'),
+            ]);
+        }
+        else {
+            return box('ftyp', [
+                ascii('iso5'), // Major brand
+                u32(minorVersion), // Minor version
+                // Compatible brands
+                ascii('iso5'),
+                ascii('iso6'),
+                ascii('mp41'),
+            ]);
+        }
