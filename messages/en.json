	"drop_reading_many": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "Reading {count} file…",
				"countPlural=other": "Reading {count} files…"
			}
		}
	],
	"batch_skipped": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} file was left out: batches take images only.",
				"countPlural=other": "{count} files were left out: batches take images only."
			}
		}
	],
	"batch_label": "Batch",
	"batch_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} image",
				"countPlural=other": "{count} images"
			}
		}
	],
