# Headers for every file Cloudflare serves (the ones nginx.conf sent on Railway).
# Rules apply in order. COOP and COEP are required for SharedArrayBuffer (FFmpeg multi-thread).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Static assets (hashed by Vite) and WebAssembly are cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/healthz
  Content-Type: text/plain; charset=utf-8

# Only the real site is listed by search engines; the workers.dev addresses never are.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex, nofollow
